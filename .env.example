# Environment variables — copy this file to `.env` and fill in real values.
# Never commit the real `.env` file or any real secrets.

# PostgreSQL connection string used by Prisma (only localhost placeholders here).
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/titife_payment_sub?schema=public"

# Paystack secret key — TEST MODE only. Get it from the Paystack dashboard:
# Settings -> API Keys & Webhooks, with the mode toggle set to Test Mode.
# Never use a live key (sk_live_...).
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# Public base URL of the app. Used for the Paystack return callback redirect (local dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000